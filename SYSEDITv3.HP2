  fi
  popd > /dev/null
# ------------------deprecated block-------------------------
# 6/3/25.	wmk.	(automated) Modification History lines dated.
fi
  ;;
"srccycle")
######################### sccycle ###########################
# update config.sh/export SRC_BUILD=2.2.1 from SRCCycle.txt
  pushd ./ > /dev/null
  cd $HOME/.config/Territories
  mawk \
  'BEGIN{getline < "SRCCycle.txt";nxtcycle=$1}/SRC_BUILD=/{printf("%s%s%s%s\n", $1, " ", substr($2,1,length($2)-1), nxtcycle)};{if (substr($2,1,8) != "SRC_BUILD")print;;}' \
   $HOME/.config/Territories/config.sh > $TEMP_PATH/newconfig.sh
  sed -i '2d' $TEMP_PATH/newconfig.sh
  sed -i "1a#\t$(date +%m/%d/%y.)\twmk." $TEMP_PATH/newconfig.sh
  oldbuild=$SRC_BUILD
  cp -pv $TEMP_PATH/newconfig.sh ./config.sh
  chmod +x ./config.sh
  . ./config.sh
  if [ $? -eq 0 ];then
   echo "** running system configuration updated **"
   isDone=1
  fi
  read -p "Do you wish to make this change permanent (y/n)? "
  yn=${REPLY^^}
  if [ $yn == "Y" ];then
   cp -pv ./config.sh $crmgit_path/ShellFiles
   cp -pv ./config.sh $WINUBUNTU_PATH/sysstart
   cd $codebase
   if test -f Build.$oldbuild;then rm Build.$oldbuild;fi
   printf "%s%s\n" "Build." "$SRC_BUILD" > Build.$SRC_BUILD
  fi
  popd > /dev/null
  ;;
"proc")
######################### proc ##############################
	# check if syseditproc is LOGMSG.
    syslogging=1
    if [ "${sysedit_proc,,}" == "logmsg" ];then
	 syslogging=0
	fi
	if [ $syslogging -ne 0 ];then \
    printf "%s%s\n" "$(date +%T) "  "  SYSEDITv3 $sysedit_version mode = '$sysedit_mode' " >> $system_log;fi
    # copy proc to running $HOME/sysprocs and WINUBUNTU_PATH/sysprocs
    if [ -z "$sysedit_proc" ]; then
#     echo "  SYSEDITv3 $sysedit_version - proc filename not specified." >> $system_log #
#     echo "  SYSEDITv3 $sysedit_version abandoned." >> $system_log #
     if [ $syslogging -ne 0 ];then \
     printf "%s%s\n" "$(date +%T) " "  SYSEDITv3 $sysedit_version - proc filename not specified."
     printf "%s\n" "   SYSEDITv3 $sysedit_version abandoned.";fi
     echo "  SYSEDITv3 $sysedit_version - proc filename not specified."
     echo "  SYSEDITv3 $sysedit_version abandoned."
     read -p "Press ctrl-c to complete exit without dropping Terminal...: "
     exit 1
    fi  # end file not specified conditional
    if [ ${sysedit_proc,,} == "sysedit" ]; then
     printf "%s%s\n" "$(date +%T) "  "  SYSEDITv3 $sysedit_version PROC = '$sysedit_proc'" >> $system_log
     printf "%s\n"  "     Cannot SYSEDITv3 itself - abandoned." >> $system_log
     echo "  SYSEDITv3 $sysedit_version PROC = '$sysedit_proc' "
     echo "SYSEDITv3 $sysedit_version will clobber itself while running..."
     echo "Run NewSYSEDIT bash script to update SYSEDITv3 $sysedit_version"
     read -p "Press ctrl-c to complete exit without dropping Terminal...: "
     exit 1
    fi 
    # copy proc to running $HOME/sysprocs and WINUBUNTU_PATH/sysprocs
    cp -pu $gitpath/ShellFiles/$sysedit_proc $WINUBUNTU_PATH/sysprocs
	cp -pu $WINUBUNTU_PATH/sysprocs/$sysedit_proc $HOME/sysprocs
    if [ $? -eq 0 ]; then
#      echo "    $sysedit_proc updated." >> $system_log #
	 if [ $syslogging -ne 0 ];then \
      printf "%s%s\n" "$(date +%T) "  "    $sysedit_proc updated." >> $system_log;fi
      echo "    $sysedit_proc updated." 
     else
#      echo "  Error copying proc to target - SYSEDITv3 $sysedit_version failed." >>$system_log #
      if [ $syslogging -ne 0 ];then \
       printf "%s%s\n" "$(date +%T) "  "  Error copying $sysedit_proc to target - SYSEDITv3 $sysedit_version failed."\
        >> $system_log;fi
       echo "  Error copying proc to target - SYSEDITv3 $sysedit_version failed."
     fi   # end copy error conditional 
    if [ $isInteractive -ne 0 ];then  
     read -p "Press ctrl-c to complete exit without dropping Terminal...: "
     exit 0
    fi
# isDone=1 - normal exit   jumpto NormalExit
  isDone=1;;
  "start")
####################### start ############################
  if [ $isChrome -ne 0 ];then
   echo "  sysedit Cannot update sysstart on Chromebook.. - abandoned."
   read -p "Press ctrl-c to complete exit without dropping Terminal...: "
   exit 1
  fi
  printf "%s%s\n" "$(date +%T) "  "  SYSEDITv3 $sysedit_version mode = '$sysedit_mode' "
    # copy proc to running ~/sysstart and WINUBUNTU_PATH/sysstart
    if [ -z "$sysedit_proc" ]; then
 #     echo "  SYSEDITv3 $sysedit_version - proc filename not specified." >> $system_log #
 #     echo "  SYSEDITv3 $sysedit_version abandoned." >> $system_log #
     printf "%s%s\n" "$(date +%T) "  "  SYSEDITv3 $sysedit_version - proc filename not specified.\n  SYSEDITv3 $sysedit_version abandoned."
     echo "  SYSEDITv3 $sysedit_version - proc filename not specified."
     echo "  SYSEDITv3 $sysedit_version abandoned."
     read -p "Press ctrl-c to complete exit without dropping Terminal...: "
     exit 1
    fi  # end file not specified conditional 
    # copy proc to running $HOME/sysprocs and WINUBUNTU_PATH/sysstart
    cp -pu $gitpath/ShellFiles/$sysedit_proc ~/sysstart
    cp -pu $gitpath/ShellFiles/$sysedit_proc $WINUBUNTU_PATH/sysstart
    if [ $? -eq 0 ]; then
#      echo "    $2 updated." >> $system_log #
     printf "%s%s\n" "$(date +%T) "  "    $sysedit_proc updated." >> $system_log
     echo "    $sysedit_proc updated." 
    else
#      echo "  Error copying proc to target - SYSEDITv3 $sysedit_version failed." >>$system_log #
     printf "%s%s\n" "$(date +%T) "  "  Error copying proc to target - SYSEDITv3 $sysedit_version failed."
      echo "  Error copying proc to target - SYSEDITv3 $sysedit_version failed."
    fi   # end no copy error conditional   
    read -p "Press ctrl-c to complete exit without dropping Terminal...: "
    exit 0
# isDone=1 - normal exit   jumpto NormalExit
  isDone=1
  ;;
  *)
########## unrecognized mode ######################
    printf "%s%s\n" "$(date +%T) "  "**  Unrecognized SYSEDITv3 $sysedit_version mode $sysedit_mode" >> $system_log
    printf "%s\n" "    SYSEDITv3 $sysedit_version abandoned." >> $system_log
    echo "  ** Unrecognized SYSEDITv3 $sysedit_version mode '$sysedit_mode' "
    echo "  SYSEDITv3 $sysedit_version abandoned."
    isDone=0
esac     # end case
#read -p "SYSEDITv3 $sysedit_version stubbed for now... Press Enter to continue..."
if [ $isDone -eq 1 ];then
 if [ $syslogging -ne 0 ];then \
 printf "%s%s\n" "$(date +%T) "  "  SYSEDITv3 $sysedit_version complete." \
   >> $system_log;fi
 echo "  SYSEDITv3 $sysedit_version complete." 
else
 echo "SYSEDITv3 $sysedit_version abnormal termination.."
fi
# end SYSEDIT
